<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.synfix</groupId>
        <artifactId>synfix-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>synfix-messages</artifactId>
    <name>SynFIX Messages</name>
    <description>FIX 4.4 message classes generated from the SynFIX custom dictionary</description>

    <dependencies>
        <!-- Generated message classes extend quickfix.Message / quickfix.FieldMap, which live
             in quickfixj-base. This mirrors the stock quickfixj-messages-fix44 module exactly. -->
        <dependency>
            <groupId>org.quickfixj</groupId>
            <artifactId>quickfixj-base</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.quickfixj</groupId>
                <artifactId>quickfixj-codegenerator</artifactId>
                <!-- The plugin expects plexus-utils via a transitive provided-scope
                     maven-project:2.2.1. Maven 3.9 no longer exports it to the plugin
                     realm, so the goal dies with NoClassDefFoundError on
                     org.codehaus.plexus.util.FileUtils unless we supply it here. -->
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.plexus</groupId>
                        <artifactId>plexus-utils</artifactId>
                        <version>3.5.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <dictFile>${project.basedir}/src/main/resources/FIX44-synfix.xml</dictFile>
                            <packaging>quickfix.fix44</packaging>
                            <fieldPackage>quickfix.field</fieldPackage>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- The generator writes to target/generated-sources; Maven does not treat that as
                 a source root by default. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
